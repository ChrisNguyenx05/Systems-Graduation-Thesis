# ==============================================================================
# WSIS: WebSocket Ingestion Service Configuration
# ==============================================================================

# MinIO S3 Bronze Storage
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=admin123
MINIO_SECRET_KEY=admin123
MINIO_BRONZE_BUCKET=crypto-bronze
MINIO_SECURE=false

# Window & QC Synchronization (15m = 900,000 ms)
WINDOW_DURATION_MS=900000
GRACE_PERIOD_SECONDS=10

# Binance Endpoints
BINANCE_SPOT_WS_BASE=wss://stream.binance.com:9443
BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com

# Target Symbols (Comma-separated)
TARGET_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,AAPLBUSDT,AMZNBUSDT,DELLBUSDT

# Buffer & Batch Limits
MAX_BUFFER_RECORDS=50000
FLUSH_BATCH_SIZE=1000

# Logging Level
LOG_LEVEL=INFO
