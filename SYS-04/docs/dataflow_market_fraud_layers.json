  "flows": [
    { "id": "market_ingest", "from": "market_api", "to": "bronze_market", "label": "market API payloads", "classification": "raw", "variant": "emphasis" },
    { "id": "transaction_ingest", "from": "transaction_api", "to": "bronze_transactions", "label": "transaction events", "classification": "raw", "variant": "emphasis" },
