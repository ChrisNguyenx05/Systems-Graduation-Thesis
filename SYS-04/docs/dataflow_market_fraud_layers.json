    { "id": "gold_risk", "type": "database", "label": "Gold Risk Features", "sublabel": "frozen features", "tag": "transaction_id", "stage": 3, "row": 2 },
    { "id": "fraud_labels", "type": "database", "label": "Fraud Labels", "sublabel": "confirmed is_fraud", "tag": "label_confirmed_at", "stage": 3, "row": 3 },
