    { "id": "market_enrichment", "from": "market_models", "to": "gold_risk", "label": "optional market risk signal", "classification": "enrichment", "variant": "dashed" },
    { "id": "fraud_training_features", "from": "gold_risk", "to": "fraud_model", "label": "feature snapshots", "classification": "model inputs", "variant": "default" },
    { "id": "fraud_training_labels", "from": "fraud_labels", "to": "fraud_model", "label": "join by transaction_id", "classification": "labelled training only", "variant": "security", "route": "straight", "labelAt": [852, 570] }
  ]
