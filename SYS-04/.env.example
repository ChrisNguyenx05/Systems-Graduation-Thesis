# ==============================================================================
# SYS-04: MLOPS & MODEL GOVERNANCE CENTER - ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Serving API Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
APP_NAME="SYS-04 MLOps & Model Governance Center"
APP_VERSION="2.0.0-production"

# 2. Storage & Model Paths
MODELS_DIR=/app/models
DATASET_DIR=/app/Dataset

# 3. MLflow Tracking & Model Registry (Port 5000)
MLFLOW_TRACKING_URI=http://sys04-mlflow-server:5000
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow-artifacts/
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 4. SYS-05 Lakehouse Integration (ClickHouse)
CLICKHOUSE_HOST=clickhouse_server
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=

# 5. SYS-06 Operational Alerting Integration
SYS06_ALERT_WEBHOOK_URL=http://sys-06-alert-dispatcher:8080/api/v1/alerts
